// =============================================================================
// schema.prisma — Prisma スキーマ定義
// 役割: DB テーブルの型安全な定義とマイグレーション管理。
//       Supabase PostgreSQL に接続する。
// 注意: auth.users テーブルは Supabase Auth が管理するため Prisma には含めない。
//       profiles テーブルで auth.users.id を参照する。
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 では接続URLは prisma.config.ts で管理する（schema.prisma には書かない）
datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// profiles — アプリ独自のユーザー情報（auth.users と 1対1）
// -----------------------------------------------------------------------------
model Profile {
  id        String   @id @db.Uuid // auth.users.id と同値
  username  String?  @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  fixedCosts       FixedCost[]
  csvImports       CsvImport[]
  receiptParseLogs ReceiptParseLog[]
  receipts         Receipt[]
  budgetFrames     BudgetFrame[]
  budgetRules      BudgetRule[]
  userLayouts      UserLayout[]
  chatUsages       ChatUsage[]
  featureRequests  FeatureRequest[]
  mcpCalls         McpCall[]

  @@map("profiles")
}

// -----------------------------------------------------------------------------
// accounts — 財布・クレカ・銀行口座などの「口座」
// -----------------------------------------------------------------------------
model Account {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  type      String // "cash" | "credit_card" | "bank"
  currency  String   @default("JPY")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  profile      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  fixedCosts   FixedCost[]
  csvImports   CsvImport[]

  @@map("accounts")
}

// -----------------------------------------------------------------------------
// categories — 収支カテゴリ（デフォルト共通 + ユーザーカスタム）
// userId が NULL のものがシステム共通カテゴリ
// -----------------------------------------------------------------------------
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid // NULL = システム共通
  name      String
  type      String // "income" | "expense"
  color     String?
  icon      String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  profile      Profile?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  fixedCosts   FixedCost[]
  budgetRules  BudgetRule[]

  @@map("categories")
}

// -----------------------------------------------------------------------------
// transactions — 全収支レコード（手入力・CSV・固定費自動生成すべてここに集約）
// -----------------------------------------------------------------------------
model Transaction {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  categoryId      String?   @map("category_id") @db.Uuid
  fixedCostId     String?   @map("fixed_cost_id") @db.Uuid // source='auto' の場合のみ
  amount          Decimal   @db.Decimal(12, 2)
  type            String // "income" | "expense"（お金の向き）
  kind            String    @default("normal") // "normal" | "refund" | "transfer" | "loan"（取引の種類。lib/aggregate/definitions.ts）
  transactionDate DateTime  @map("transaction_date") @db.Date
  note            String?
  source          String // "manual" | "csv" | "auto" | "api" | "receipt"（"api" = 利用者の AI エージェントが /api/mcp で追加。mywork#882）
  csvImportId     String?   @map("csv_import_id") @db.Uuid // source='csv' の場合のみ
  importKey       String?   @map("import_key") // CSV の行の目印（lib/csv/import-key.ts）。利用者ごとに一意
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz // 論理削除
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  profile   Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account    @relation(fields: [accountId], references: [id])
  category  Category?  @relation(fields: [categoryId], references: [id])
  fixedCost FixedCost? @relation(fields: [fixedCostId], references: [id], onDelete: SetNull)
  csvImport CsvImport? @relation(fields: [csvImportId], references: [id])
  receipt   Receipt?

  @@unique([userId, importKey])
  @@map("transactions")
}

// -----------------------------------------------------------------------------
// fixed_costs — 定期支出・定期収入の定義（毎週・隔週・毎月・毎年）
// 展開は lib/fixed-costs/expand.ts。generatedThrough より後・今日までの支払日だけ取引を作る
// -----------------------------------------------------------------------------
model FixedCost {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  categoryId       String?   @map("category_id") @db.Uuid
  name             String
  amount           Decimal   @db.Decimal(12, 2)
  type             String    @default("expense") // "income" | "expense"
  cycle            String    @default("monthly") // "weekly" | "biweekly" | "monthly" | "yearly"
  billingDay       Int?      @map("billing_day") // 1〜31（毎月・毎年）。毎週・隔週は NULL
  billingMonth     Int?      @map("billing_month") // 1〜12（毎年のみ）
  startDate        DateTime  @default(dbgenerated("((now() AT TIME ZONE 'Asia/Tokyo'::text))::date")) @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  generatedThrough DateTime? @map("generated_through") @db.Date // この日まで展開済み
  isActive         Boolean   @default(true) @map("is_active")
  // 固定の判定の条件（lib/fixed/classify.ts）。手入力・CSV の取引がそろえば「固定」として集計する
  matchNote        String?   @map("match_note") // メモに含まれる語句。NULL なら見ない
  matchAnyAmount   Boolean   @default(false) @map("match_any_amount") // true なら金額を見ない
  currency         String    @default("JPY") // "JPY" | "USD"。USD は amount がドルで、取引にするときその日のドル円で円に直す
  // サブスクの管理欄（mywork#742 ②）。全部任意。一覧は /subscriptions（lib/subscriptions/list.ts）
  isSubscription   Boolean   @default(false) @map("is_subscription")
  manageUrl        String?   @map("manage_url") // 管理ページの URL（http/https のみ）
  cancelUrl        String?   @map("cancel_url") // 解約・プラン変更の URL（http/https のみ）
  nextRenewalDate  DateTime? @map("next_renewal_date") @db.Date // 手入力の次回更新日。NULL・過ぎたら支払日から自動
  paymentCard      String?   @map("payment_card") // 支払いカード（カード会社名・券種の自由記述。番号は持たない）
  memo             String? // 自由記入のメモ（match_note とは別物）
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  profile      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@map("fixed_costs")
}

// -----------------------------------------------------------------------------
// csv_imports — CSVアップロード履歴（重複インポート防止）
// -----------------------------------------------------------------------------
model CsvImport {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  filename     String
  status       String   @default("pending") // "pending" | "success" | "error"
  rowCount     Int      @default(0) @map("row_count")
  skippedCount Int      @default(0) @map("skipped_count")
  importedAt   DateTime @default(now()) @map("imported_at") @db.Timestamptz

  // Relations
  profile      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id])
  transactions Transaction[]

  @@map("csv_imports")
}

// -----------------------------------------------------------------------------
// receipt_parse_logs — レシート読み取り1回ごとの記録（回数制限 L1〜L6 と費用の記録）
// 書き込みはサーバーの管理者接続（lib/admin-db.ts）だけ。画像・読み取り結果は入れない（P5）
// -----------------------------------------------------------------------------
model ReceiptParseLog {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  status       String    @default("reserved") // "reserved" | "succeeded" | "failed" | "cancelled"
  countsGlobal Boolean   @default(true) @map("counts_global")
  model        String?
  inputTokens  Int?      @map("input_tokens")
  outputTokens Int?      @map("output_tokens")
  costUsd      Decimal?  @map("cost_usd") @db.Decimal(10, 6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("receipt_parse_logs")
}

// -----------------------------------------------------------------------------
// receipts — 利用者が確認して保存したレシート。明細のカテゴリごとに取引を分けたときは、いちばん大きい取引にぶら下げる（mywork#229）。画像は持たない（P5）
// -----------------------------------------------------------------------------
model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  transactionId String   @unique @map("transaction_id") @db.Uuid
  merchant      String
  purchasedAt   DateTime @map("purchased_at") @db.Date
  total         Decimal  @db.Decimal(12, 2)
  items         Json     @default("[]")
  model         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile     Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId, purchasedAt])
  @@map("receipts")
}

// -----------------------------------------------------------------------------
// budget_frames — 予算の費目（食費・サブスク・…）と月の上限・目標（社長の予算台帳。lib/budget/*）
// -----------------------------------------------------------------------------
model BudgetFrame {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  monthlyLimit Int      @map("monthly_limit")
  target       Int?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules   BudgetRule[]

  @@unique([userId, name])
  @@map("budget_frames")
}

// -----------------------------------------------------------------------------
// budget_rules — カテゴリー／メモの語句 → 費目の対応表。frameId が null なら「枠の外」
// 振り分けは取引に保存せず、集計のたびにこの表で決める（lib/budget/classify.ts）
// -----------------------------------------------------------------------------
model BudgetRule {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  memoKeyword String?  @map("memo_keyword")
  frameId     String?  @map("frame_id") @db.Uuid
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile  Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  frame    BudgetFrame? @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("budget_rules")
}

// -----------------------------------------------------------------------------
// user_layout — マイメニュー（本人がチャットで足した機能。行がある＝表示）mywork#573
// 固定の5つはコード側（lib/menu/catalog.ts）で決め、ここには入れない
// -----------------------------------------------------------------------------
model UserLayout {
  userId    String   @map("user_id") @db.Uuid
  featureId String   @map("feature_id")
  position  Int      @default(0)
  icon      String?
  label     String?
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, featureId])
  @@map("user_layout")
}

// -----------------------------------------------------------------------------
// chat_usage — チャットの1日の回数（上限を数えるためだけ。会話の中身は保存しない）
// -----------------------------------------------------------------------------
model ChatUsage {
  userId String   @map("user_id") @db.Uuid
  day    DateTime @db.Date
  count  Int      @default(0)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("chat_usage")
}

// -----------------------------------------------------------------------------
// feature_requests — 無い機能の要望（mywork#573 第2弾）。会話は保存せず要望文だけ
// -----------------------------------------------------------------------------
model FeatureRequest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  text      String
  status    String   @default("received")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "feature_requests_user_created_idx")
  @@map("feature_requests")
}

// -----------------------------------------------------------------------------
// mcp_calls — AI エージェント（/api/mcp）からの道具の呼び出し記録（mywork#882）
// 回数の上限と「AI 接続まで行った人数」を数えるためだけ。金額・メモなど中身は保存しない
// -----------------------------------------------------------------------------
model McpCall {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clientId  String   @map("client_id")
  tool      String
  isWrite   Boolean  @default(false) @map("is_write")
  ok        Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "mcp_calls_user_created_idx")
  @@map("mcp_calls")
}

// -----------------------------------------------------------------------------
// lp_views / waitlist_signups — 広告の着地ページの閲覧数と事前登録（mywork#878）。
// RLS 有効・ポリシー無し。読み書きは lib/admin-db.ts だけ
// -----------------------------------------------------------------------------
model LpView {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewedAt     DateTime @default(now()) @map("viewed_at") @db.Timestamptz
  visitorId    String   @map("visitor_id")
  utmSource    String?  @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  utmCampaign  String?  @map("utm_campaign")
  utmContent   String?  @map("utm_content")
  referrerHost String?  @map("referrer_host")

  @@index([visitorId, viewedAt(sort: Desc)], map: "lp_views_visitor_viewed_idx")
  @@map("lp_views")
}

model Subscription {
  userId               String    @id @map("user_id") @db.Uuid
  stripeCustomerId     String    @unique @map("stripe_customer_id")
  stripeSubscriptionId String    @unique @map("stripe_subscription_id")
  status               String
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("subscriptions")
}

model WaitlistSignup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  visitorId   String?  @map("visitor_id")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  utmContent  String?  @map("utm_content")

  @@index([visitorId, createdAt(sort: Desc)], map: "waitlist_signups_visitor_created_idx")
  @@map("waitlist_signups")
}
